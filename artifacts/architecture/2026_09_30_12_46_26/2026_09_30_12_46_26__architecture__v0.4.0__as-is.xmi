        <UML:Dependency xmi.id="observed.dep.widget_orchestration" client="observed.chat_widget" supplier="observed.channel_agents" name="runs browser agent turn loop" documentation="evidence: clients/web/subjective_web_dashboard/src/components/chat/ChatWidget.tsx | confidence: high | Static source relationship; execution not tested." />
