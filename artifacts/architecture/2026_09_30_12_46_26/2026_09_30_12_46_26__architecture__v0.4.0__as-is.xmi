        <UML:Dependency xmi.id="observed.dep.design_chat_proxy" client="observed.team_design_chat_client" supplier="observed.pipelines_proxy" name="same-origin API request" documentation="evidence: clients/web/subjective_web_pipelines/src/lib/team-design-chat.ts | confidence: high | Static source relationship; execution not tested." />
        <UML:Dependency xmi.id="observed.dep.worktree_diff" client="observed.uml2code_worktree_app" supplier="observed.xmi_diff" name="computes model diff" documentation="evidence: services/subjective_uml2code/src/subjective_uml2code/app.py | confidence: high | Static source relationship; execution not tested." />
        <UML:Dependency xmi.id="observed.dep.worktree_sync" client="observed.uml2code_worktree_app" supplier="observed.code_sync" name="reconciles generated output" documentation="evidence: services/subjective_uml2code/src/subjective_uml2code/app.py | confidence: high | Static source relationship; execution not tested." />
        <UML:Dependency xmi.id="observed.dep.container_api" client="observed.chat_container" supplier="cls_chat_api" name="proxies HTTP and WebSocket" documentation="evidence: services/subjective_api_chat/deploy/cloudflare/worker/index.ts | confidence: high | Static source relationship; execution not tested." />
