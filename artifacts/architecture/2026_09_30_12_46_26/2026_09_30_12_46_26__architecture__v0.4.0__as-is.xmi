<?xml version='1.0' encoding='utf-8'?>
<XMI xmlns:UML="org.omg.xmi.namespace.UML" xmi.version="1.2">
  <XMI.content>
    <UML:Model xmi.id="observed.model.recent_changes.v040" name="Subjective AS-IS recent-change slice v0.4.0" documentation="Observed 2026_09_30_12_46_26 UTC. Root HEAD 08bba9fd2c8748ee3b152f30a375bdea27cbf851. Scoped incremental inventory, not a complete repository model or conformance verdict. Working tree and root-pinned UML2Code version are explicitly separated. Existing AS-IS baseline v0.3.0 records root bcb6361c. Canonical pointer resolves to SubjectiveAppsV4.xmi; provisional v4.2.0 also compared. No production deployment or database migration state verified. Evidence hashes in evidence.json. Intended destination docs/architecture/as-is; staged here because that directory is outside writable roots.">
      <UML:Namespace.ownedElement>
        <UML:Class xmi.id="cls_d1_users" name="users" documentation="evidence: services/subjective_user_service/schema/migrations/2026_09_23_unified_user_identity_user_kind.sql | confidence: high | Migration adds RU/AI discriminator and self-referencing creator; forbids AI owner. Migration presence does not establish production application.">
          <UML:Classifier.feature>
            <UML:Attribute xmi.id="cls_d1_users.user_kind" name="user_kind" documentation="RU or AI; evidence and confidence inherited from owning class." />
            <UML:Attribute xmi.id="cls_d1_users.created_by_user_id" name="created_by_user_id" documentation="Self-reference; required for AI; evidence and confidence inherited from owning class." />
          </UML:Classifier.feature>
        </UML:Class>
        <UML:Class xmi.id="cls_d1_ai_user_profiles" name="ai_user_profiles" documentation="evidence: services/subjective_user_service/schema/migrations/2026_09_23_unified_user_identity_user_kind.sql | confidence: high | One profile per users row, cascading FK; prompt, provider/model binding, visibility and moderation metadata.">
          <UML:Classifier.feature>
            <UML:Attribute xmi.id="cls_d1_ai_user_profiles.system_prompt" name="system_prompt" documentation="Persisted AI profile field; evidence and confidence inherited from owning class." />
            <UML:Attribute xmi.id="cls_d1_ai_user_profiles.default_provider_id" name="default_provider_id" documentation="Persisted AI profile field; evidence and confidence inherited from owning class." />
            <UML:Attribute xmi.id="cls_d1_ai_user_profiles.default_model_id" name="default_model_id" documentation="Persisted AI profile field; evidence and confidence inherited from owning class." />
            <UML:Attribute xmi.id="cls_d1_ai_user_profiles.visibility" name="visibility" documentation="Persisted AI profile field; evidence and confidence inherited from owning class." />
            <UML:Attribute xmi.id="cls_d1_ai_user_profiles.prompt_moderation" name="prompt_moderation" documentation="Persisted AI profile field; evidence and confidence inherited from owning class." />
          </UML:Classifier.feature>
        </UML:Class>
        <UML:Class xmi.id="observed.ai_users_router" name="AI users router" documentation="evidence: services/subjective_user_service/src/subjective_user_service/routers/domain/ai_users.py | confidence: high | Authenticated AI user creation/profile lifecycle; recursion limits from SUBJECTIVE_MAX_AI_CREATION_DEPTH and SUBJECTIVE_MAX_AI_USERS_PER_RU; source default prompt limit 40000." />
        <UML:Class xmi.id="cls_chat_conversations" name="conversations" documentation="evidence: services/subjective_api_chat/src/subjective_chat_api/schema.sql | confidence: high | SQLite conversations contain name/topic, unlike v0.3.0. metadata_json stores team_key through ChatRepository.">
          <UML:Classifier.feature>
            <UML:Attribute xmi.id="cls_chat_conversations.name" name="name" documentation="Conversation column; evidence and confidence inherited from owning class." />
            <UML:Attribute xmi.id="cls_chat_conversations.topic" name="topic" documentation="Conversation column; evidence and confidence inherited from owning class." />
            <UML:Attribute xmi.id="cls_chat_conversations.metadata_json" name="metadata_json" documentation="Conversation column; evidence and confidence inherited from owning class." />
          </UML:Classifier.feature>
        </UML:Class>
        <UML:Class xmi.id="cls_chat_api" name="ChatApi" documentation="evidence: services/subjective_api_chat/src/subjective_chat_api/main.py | confidence: high | Named group creation; member GET/POST/DELETE; POST /chat/conversations/{conversation_id}/agent-messages takes sender_id under caller authentication. Checks caller active membership and target AI id prefix plus active/invited membership; no proof of agent-generated content is checked here." />
        <UML:Class xmi.id="cls_chat_repository" name="ChatRepository" documentation="evidence: services/subjective_api_chat/src/subjective_chat_api/repository.py | confidence: high | Persists team_key in metadata_json; find_group_by_team_key uses SQLite json_extract." />
        <UML:Class xmi.id="observed.channel_agents" name="Channel agent orchestration" documentation="evidence: clients/web/subjective_web_dashboard/src/lib/chat/channelAgents.ts | confidence: high | Browser-side mention parsing and replyChannelThread orchestration; addressed agents first, all if unaddressed; each agent speaks at most once per invocation." />
        <UML:Class xmi.id="observed.chat_widget" name="ChatWidget" documentation="evidence: clients/web/subjective_web_dashboard/src/components/chat/ChatWidget.tsx | confidence: high | Calls deliverAgentMessage per AI, then posts returned text through ChatClient agent-messages endpoint using signed-in caller." />
        <UML:Class xmi.id="observed.devagents_chat_adapter" name="DevAgents chat adapter" documentation="evidence: clients/web/subjective_web_dashboard/src/lib/devagentsChat.ts | confidence: high | Creates conversations and sends messages through /api/llm/create-conversation and /api/llm/send-message." />
        <UML:Class xmi.id="observed.team_channels" name="Team channel mapping" documentation="evidence: clients/web/subjective_web_dashboard/src/components/chat/teamChannels.ts | confidence: high | Loads membership; binds channel team_key to saved team; groups by design/company label; same named teams in different designs remain distinct." />
        <UML:Class xmi.id="observed.team_design_membership" name="Team design membership endpoint" documentation="evidence: clients/web/subjective_web_dashboard/functions/api/worktwins/[[path]].js | confidence: high | Reads user_teamdesigns.document_json; selects owned/member teams; emits composite design-row-id:team-id and composite parentId." />
        <UML:Class xmi.id="cls_team_map_editor" name="TeamMapEditor" documentation="evidence: clients/web/subjective_web_pipelines/src/components/TeamMapEditor.tsx | confidence: high | Nested teams via internalData.parentTeamId and cycle prevention; generateTeamDesign called by editor. This snapshot does not repeat old unverified use-case completion labels." />
        <UML:Class xmi.id="observed.team_design_chat_client" name="Team Design chat client" documentation="evidence: clients/web/subjective_web_pipelines/src/lib/team-design-chat.ts | confidence: high | POST /team-design-api/v1/team-designs/generate by default; sends message/history/document/directory and bearer token. NEXT_PUBLIC_UML2CODE_API_BASE overrides base." />
        <UML:Component xmi.id="observed.pipelines_proxy" name="Pipelines Next rewrites" documentation="evidence: clients/web/subjective_web_pipelines/next.config.ts | confidence: high | Same-origin /team-design-api proxies to https://uml2code.subjectivetechnologies.com." />
        <UML:Class xmi.id="observed.uml2code_pinned_team_design" name="Root-pinned UML2Code Team Design generator" documentation="evidence: services/subjective_uml2code/src/subjective_uml2code/team_design_chat.py@42b15e5 | confidence: high | Present in root gitlink 42b15e5; NOT present in current checked-out UML2Code HEAD b7e83c6. Backend sanitizes generated team design against directory. This is a pinned-source observation, not deployed evidence." />
        <UML:Class xmi.id="observed.uml2code_worktree_app" name="Working-tree UML2Code app" documentation="evidence: services/subjective_uml2code/src/subjective_uml2code/app.py | confidence: high | Dirty working tree imports structured_diff/summarize_diff and reconcile_file, and wires reconciliation to /v1/generate. No /v1/team-designs/generate route in this checked-out source." />
        <UML:Class xmi.id="observed.xmi_diff" name="Structured XMI diff" documentation="evidence: services/subjective_uml2code/src/subjective_uml2code/xmi_diff.py | confidence: high | Untracked implementation indexes stable xmi.id and reports added/removed/changed model elements." />
        <UML:Class xmi.id="observed.code_sync" name="Generated code reconciliation" documentation="evidence: services/subjective_uml2code/src/subjective_uml2code/code_sync.py | confidence: high | Untracked async implementation sends generated/live source plus model diff to chat_provider via httpx. No external request made during this review." />
        <UML:Node xmi.id="observed.chat_container" name="ChatContainer" documentation="evidence: services/subjective_api_chat/deploy/cloudflare/worker/index.ts | confidence: high | Cloudflare Worker and Durable Object proxy to chat-singleton, container port 8080, sleepAfter 1h; Wrangler secret bindings passed via envVars." />
        <UML:Component xmi.id="observed.chat_replication" name="Chat SQLite replication startup" documentation="evidence: services/subjective_api_chat/deploy/cloudflare/entrypoint.sh | confidence: high | Restores and replicates SQLite via Litestream when R2 credentials are present; starts ephemeral-only uvicorn when absent. Configuration behavior, not observed production state." />
        <UML:Node xmi.id="observed.chat_r2_replica" name="Chat R2 replica" documentation="evidence: services/subjective_api_chat/deploy/cloudflare/litestream.yml | confidence: high | S3-compatible replication of /data/subjective_chat.db to subjective_chat prefix. Credentials supplied by environment; values not read." />
        <UML:Class xmi.id="observed.path_resolver" name="SubjectiveControlConfig" documentation="evidence: libs/subjective_control_lib/src/subjective_control/config.py | confidence: high | Expands user/env paths and config tokens. /subjective/clients/subjective.conf referenced by WORKSPACE.md is absent in current filesystem." />
        <UML:Dependency xmi.id="observed.dep.ai_profiles_users" client="cls_d1_ai_user_profiles" supplier="cls_d1_users" name="profile FK user_id" documentation="evidence: services/subjective_user_service/schema/migrations/2026_09_23_unified_user_identity_user_kind.sql | confidence: high | Static source relationship; execution not tested." />
        <UML:Dependency xmi.id="observed.dep.ai_router_profiles" client="observed.ai_users_router" supplier="cls_d1_ai_user_profiles" name="reads and writes profiles" documentation="evidence: services/subjective_user_service/src/subjective_user_service/routers/domain/ai_users.py | confidence: high | Static source relationship; execution not tested." />
        <UML:Dependency xmi.id="observed.dep.api_repository" client="cls_chat_api" supplier="cls_chat_repository" name="persists channel messages" documentation="evidence: services/subjective_api_chat/src/subjective_chat_api/main.py | confidence: high | Static source relationship; execution not tested." />
